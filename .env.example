APP_PORT=8080
# Update the host segment if PostgreSQL runs elsewhere (e.g., the Docker host's LAN IP on Linux).
DATABASE_URL=postgresql://dockpilot:dockpilot@host.docker.internal:5432/dockpilot
SESSION_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
# Optional: enable Docker metrics by pointing at a reachable Docker API endpoint
# DOCKER_PROXY_URL=http://host.docker.internal:2375
NGINX_SITES_DIR=/etc/nginx/sites-enabled
HEALTH_INTERVAL_MS=60000
HEALTH_TIMEOUT_MS=8000
COLLECTOR_INTERVAL_MS=30000
COLLECTOR_SIZE_INTERVAL_MS=180000
AI_ASSISTANT_ENABLED=false
OPENAI_API_KEY=
