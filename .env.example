DATABASE_URL=postgresql://dockpilot:dockpilot@localhost:5432/dockpilot
SESSION_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
# DO NOT set DOCKER_HOST here. It will override the host's Docker environment.
#
# To override the internal proxy URL, set DOCKER_PROXY_URL instead
# (the docker-compose file already defaults to http://socket-proxy:2375)
# Example:
# DOCKER_PROXY_URL=http://socket-proxy:2375
NGINX_SITES_DIR=/etc/nginx/sites-enabled
HEALTH_INTERVAL_MS=60000
HEALTH_TIMEOUT_MS=8000
COLLECTOR_INTERVAL_MS=30000
COLLECTOR_SIZE_INTERVAL_MS=180000
AI_ASSISTANT_ENABLED=false
OPENAI_API_KEY=
# --- HAProxy host port mapping ---
# If port 80 is already used by nginx or another service on your host,
# set HAPROXY_HTTP_PORT to a free port like 8080. The container will still
# listen on port 80 internally; only the host-binding changes.
HAPROXY_HTTP_PORT=8080

# Uncomment when TLS termination is configured in HAProxy
# HAPROXY_HTTPS_PORT=8443
